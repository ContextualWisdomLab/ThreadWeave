+        for keys in new_components:
+            component_id = keys[0]
+            self._keys_by_component[component_id] = keys
+            for key in keys:
+                self._component_by_key[key] = component_id
+
+        self._next_position = next_position
         self._roots = None
         self._projections = None
         self._version = version
